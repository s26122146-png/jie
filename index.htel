                </div>
            </div>

            <!-- Week 6 -->
            <div class="quest-card locked" onclick="showLockedMessage(6)">
                <div class="card-top">
                    <span class="week-tag">WEEK 06</span>
                    <span class="badge-status">🔒 尚未解鎖</span>
                </div>
                <div class="card-body">
                    <i class="fa-solid fa-lock card-icon"></i>
