            <!-- Week 16 -->
            <div class="quest-card locked" onclick="showLockedMessage(16)">
                <div class="card-top">
                    <span class="week-tag">WEEK 16</span>
                    <span class="badge-status">🔒 尚未解鎖</span>
                </div>
                <div class="card-body">
