        </main>

        <section class="code-export-section">
            <div class="code-header">
                <div class="code-title">
                    <i class="fa-solid fa-code"></i> 程式碼檢視與交作業助手
                </div>
                <div class="code-tabs">
                    <button class="tab-btn active" onclick="switchTab('html')">HTML 結構</button>
                    <button class="tab-btn" onclick="switchTab('css')">CSS 樣式</button>
                </div>
                <button class="copy-btn" onclick="copyCurrentCode()">
                    <i class="fa-regular fa-copy"></i> 複製此區塊程式碼
                </button>
            </div>
            
            <pre class="code-content active" id="code-html"><code>&lt;!-- 作品集 index.html 結構 --&gt;
&lt;div class="container"&gt;
  &lt;header class="profile-header"&gt;
    &lt;img src="avatar.jpg" class="avatar"&gt;
    &lt;h1&gt;前端闖關冒險者&lt;/h1&gt;
  &lt;/header&gt;

  &lt;main class="grid-container"&gt;
    &lt;!-- Week 1 (已解鎖) --&gt;
    &lt;a href="w1/index.html" class="quest-card unlocked"&gt;
      Week 1 - 數位名片
    &lt;/a&gt;
    &lt;!-- Week 2 (已解鎖) --&gt;
    &lt;a href="w2/index.html" class="quest-card unlocked"&gt;
      Week 2 - 今天吃甚麼?
    &lt;/a&gt;
    &lt;!-- Week 3 ~ 16 (鎖定) --&gt;
    &lt;div class="quest-card locked"&gt;🔒 Week 3 - 尚未解鎖&lt;/div&gt;
    ...
  &lt;/main&gt;
&lt;/div&gt;</code></pre>

            <pre class="code-content" id="code-css"><code>/* 莫蘭迪奶茶色系 CSS 核心樣式 */
:root {
  --bg-main: #f5f0eb;
  --bg-card: #ffffff;
  --bg-card-locked: #eae5e0;
  --accent-color: #c89676;
}

body {
  background-color: var(--bg-main);
  font-family: 'Noto Sans TC', sans-serif;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.quest-card.unlocked:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 32px rgba(120, 100, 85, 0.12);
}</code></pre>
        </section>
    </div>

    <!-- 複製成功提示框 -->
    <div class="toast" id="toast">複製成功！已準備好交作業囉 🚀</div>

    <script>
        let currentTab = 'html';

        // 點擊未解鎖關卡時的提示
        function showLockedMessage(weekNum) {
            showToast(`🔒 Week ${weekNum} 關卡尚未開啟，請先完成前面的任務！`);
        }

        // 顯示快訊提示
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // 切換 HTML / CSS 頁籤
        function switchTab(type) {
            currentTab = type;
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.code-content').forEach(block => block.classList.remove('active'));

            if (type === 'html') {
                document.querySelectorAll('.tab-btn')[0].classList.add('active');
                document.getElementById('code-html').classList.add('active');
            } else {
                document.querySelectorAll('.tab-btn')[1].classList.add('active');
                document.getElementById('code-css').classList.add('active');
            }
        }

        // 複製當前顯示的程式碼
        function copyCurrentCode() {
            const targetId = currentTab === 'html' ? 'code-html' : 'code-css';
            const codeText = document.getElementById(targetId).textContent;

            // 使用相容性高的複製機制
            const textarea = document.createElement('textarea');
            textarea.value = codeText;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);

            showToast(`已複製 ${currentTab.toUpperCase()} 程式碼至剪貼簿！`);
        }
    </script>
</body>
</html>
