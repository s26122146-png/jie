                </div>
            </div>

            <!-- Week 9 -->
            <div class="quest-card locked" onclick="showLockedMessage(9)">
                <div class="card-top">
                    <span class="week-tag">WEEK 09</span>
                    <span class="badge-status">🔒 尚未解鎖</span>
                </div>
                <div class="card-body">
                    <i class="fa-solid fa-lock card-icon"></i>
                    <h2 class="card-title">Week 9 - 尚未解鎖</h2>
